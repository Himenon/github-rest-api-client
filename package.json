{
  "name": "@himenon/github-rest-api-client-specification",
  "version": "0.1.0",
  "private": true,
  "description": "github-rest-api-clientの自動生成",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Himenon/github-rest-api-client.git"
  },
  "sideEffects": false,
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/esm/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "run-s clean build:code",
    "build:code": "node --strip-types ./scripts/buildCode.ts",
    "build:docs": "node --strip-types ./scripts/buildDocs.ts",
    "clean": "node --strip-types ./scripts/clean.ts",
    "json2schema": "node --strip-types ./scripts/json2schema.ts",
    "mock:server": "node --strip-types ./scripts/mockServer.ts",
    "format": "oxfmt",
    "type-check": "tsc --noEmit",
    "lint": "oxlint .",
    "validate": "oxfmt --check",
    "publish:ghpages": "gh-pages --dist ./docs -b gh-pages",
    "release:github:registry": "pnpm publish --registry https://npm.pkg.github.com/",
    "release:npm:registry": "pnpm publish"
  },
  "dependencies": {
    "@types/superagent": "8.1.9",
    "superagent": "10.3.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-cli": "4.0.4",
    "@himenon/openapi-typescript-code-generator": "2.0.3",
    "@stoplight/prism-cli": "5.15.10",
    "@types/fs-extra": "11.0.4",
    "@types/node": "25.7.0",
    "@types/rimraf": "4.0.5",
    "api-spec-converter": "2.12.0",
    "chalk": "5.6.2",
    "cherry-pick": "0.5.0",
    "chokidar": "5.0.0",
    "conventional-changelog-angular-all": "1.7.0",
    "cpy": "13.2.2",
    "execa": "9.6.1",
    "fs-extra": "11.3.5",
    "gh-pages": "6.3.0",
    "json2yaml": "1.1.0",
    "lefthook": "^2.1.6",
    "lerna": "9.0.7",
    "npm-run-all": "4.1.5",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "rimraf": "6.1.3",
    "sort-package-json": "3.6.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.2"
}
